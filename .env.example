# Google Search Console — HTML-tag verification code (the content= value only).
# Domain property accesofutbol.com already covers www; this is optional extra proof.
GOOGLE_SITE_VERIFICATION=

# Sportmonks — primary live data (https://www.sportmonks.com/)
# Liga MX is hardcoded as league id 743; Liga MX Femenil (Women) is 1579.
# See src/lib/sports/sportmonks.ts
SPORTMONKS_API_TOKEN=
# starter | growth | pro | enterprise — drives soft throttle (90% of plan hourly cap)
SPORTMONKS_PLAN=starter

# Optional shared cache across Vercel isolates (form, H2H, date boards).
# Create a Redis REST database at https://upstash.com and paste both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Acceso Radio (Phase B) — works with templates + browser speech without keys
RADIO_ENABLED=true
RADIO_DELAY_MS=30000
# Anthropic (Vercel AI SDK) — auto-read by @ai-sdk/anthropic; never commit the key
ANTHROPIC_API_KEY=
# Haiku for radio polish + cable Acceso lines (cheap). Use claude-sonnet-4-20250514 for heavier work.
ANTHROPIC_RADIO_MODEL=claude-haiku-4-5
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_DEFAULT=
ELEVENLABS_VOICE_CALIENTE=
ELEVENLABS_VOICE_TACTICO=
ELEVENLABS_VOICE_PUENTE=

# Toma episode = single-narrator ElevenLabs voice (uses ELEVENLABS_VOICE_CALIENTE, else ELEVENLABS_VOICE_DEFAULT).
# Cron + /api/toma after() generate the show when the day is closed.
CRON_SECRET=
# Set automatically on Vercel when a Blob store is connected (token and/or BLOB_STORE_ID).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Web Push (avisos de gol / saque). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Public key is exposed to the browser (applicationServerKey); private key stays server-only.
# Subscriptions persist in Upstash; the /api/cron/push-dispatch cron sends goal/kickoff alerts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@accesofutbol.com
